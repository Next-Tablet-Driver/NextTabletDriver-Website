---
const features = [
	{
		index: '01',
		title: 'Low latency',
		description:
			'Optimized polling, high-priority input threads, and a compact Rust pipeline keep lag low enough to disappear.',
	},
	{
		index: '02',
		title: 'Precise mapping',
		description:
			'Active area, target display selection, rotation, aspect-ratio lock, and edge snapping, configured exactly.',
	},
	{
		index: '03',
		title: 'Custom themes',
		description: 'JSON-based theming with full color palettes, spacing controls, and osu! playfield opacity.',
	},
	{
		index: '04',
		title: 'Built-in telemetry',
		description: 'A live console, performance monitoring, Antichatter filtering, and WebSocket output.',
	},
	{
		index: '05',
		title: 'Cross-platform',
		description: 'Native Windows input APIs and Linux uinput support. One driver, either way.',
	},
];
---

<section id="features" class="border-t border-border bg-surface/40 px-6 py-24">
	<div class="mx-auto max-w-5xl">
		<div class="max-w-3xl">
			<p class="font-mono text-xs tracking-widest text-fg-muted uppercase" data-reveal>Features</p>
			<h2 class="font-display mt-4 text-3xl font-medium tracking-tight text-fg sm:text-4xl" data-reveal>
				Built for people who notice the delay.
			</h2>
		</div>

		<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				features.map((feature) => (
					<div
						class="rounded-xl border border-border bg-canvas p-6 transition-colors hover:border-accent/40"
						data-reveal
					>
						<span class="font-mono text-xs text-accent">{feature.index}</span>
						<h3 class="mt-3 text-lg font-medium text-fg">{feature.title}</h3>
						<p class="mt-2 text-sm text-fg-muted">{feature.description}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
