---
import { REPO_URL, RELEASES_URL, TABLETS_URL } from '../lib/github';
---

<footer class="border-t border-border px-6 py-10">
	<div
		class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 text-sm text-fg-muted sm:flex-row"
	>
		<p class="font-mono text-xs">NextTabletDriver · MIT License</p>
		<div class="flex items-center gap-6">
			<a href={REPO_URL} target="_blank" rel="noreferrer" class="transition-colors hover:text-fg">
				GitHub
			</a>
			<a href={TABLETS_URL} target="_blank" rel="noreferrer" class="transition-colors hover:text-fg">
				Tablets
			</a>
			<a href={RELEASES_URL} target="_blank" rel="noreferrer" class="transition-colors hover:text-fg">
				Releases
			</a>
		</div>
	</div>
</footer>
