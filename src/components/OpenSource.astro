---
import type { GithubData } from '../lib/github';

interface Props {
	data: GithubData;
}

const { data } = Astro.props;
const { repo } = data;
---

<section id="open-source" class="border-t border-border bg-surface/40 px-6 py-24">
	<div class="mx-auto max-w-2xl text-center" data-reveal>
		<p class="font-mono text-xs tracking-widest text-fg-muted uppercase">Open source</p>
		<h2 class="font-display mt-4 text-3xl font-medium tracking-tight text-fg sm:text-4xl">
			{repo.license ?? 'MIT'} licensed. Built in the open.
		</h2>
		<p class="mx-auto mt-4 max-w-md text-fg-muted">
			Every driver, every theme, every tablet definition is on GitHub. Issues, pull requests, and
			new device configs are always welcome.
		</p>
		<div class="mt-8 flex flex-wrap justify-center gap-4">
			<a
				href={repo.htmlUrl}
				target="_blank"
				rel="noreferrer"
				class="inline-flex items-center gap-2 rounded-full border border-border px-5 py-2.5 text-sm text-fg transition-colors hover:border-accent hover:text-accent"
			>
				Star on GitHub
				{repo.stars !== null && (
					<span class="font-mono text-fg-muted">{repo.stars.toLocaleString('en-US')}</span>
				)}
			</a>
			<a
				href={`${repo.htmlUrl}/issues`}
				target="_blank"
				rel="noreferrer"
				class="inline-flex items-center rounded-full border border-border px-5 py-2.5 text-sm text-fg-muted transition-colors hover:border-accent hover:text-fg"
			>
				Report an issue
			</a>
		</div>
	</div>
</section>
